# npu_rr_lock (多通道 DMA 的埠選擇器): one-hot、只選請求者、等待 grant 時保持、round-robin 公平 (每個主端最多等 NM − 1 次)
# NM = 3 (非 2 的冪, 檢查取模的 round-robin)
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 12

[engines]
smtbmc z3

[script]
read_verilog -sv -formal npu_rr_lock.v
chparam -set NM 3 npu_rr_lock
prep -top npu_rr_lock

[files]
npu_rr_lock.v
