# npu_dma_mc (多通道 DMA): 命令交給最小的空閒通道、四個共用埠的 grant / 位址 / 資料屬於得主、
# 外部讀回應依序送回發出者 (任選一個讀取追蹤)、完成槽 id; NDC = 2, OUT = 4, DW = 8; 通道為替身
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 12

[engines]
smtbmc z3

[script]
read_verilog -sv -formal npu_dma_mc.v
chparam -set NDC 2 -set OUT 4 -set DW 8 npu_dma_mc
prep -top npu_dma_mc

[files]
npu_dma_mc.v
