# orca_npu_ss 前端 (佇列 / 分派 / 等待旗標 / 未完成數 / 完成合併): QD = 4, NCU = 2; npu_core / DMA / ICG 為 stubs.sv 的契約替身
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 30

[engines]
smtbmc z3

[script]
read_verilog -sv -formal orca_npu_ss.v
chparam -set QD 4 -set NCU 2 orca_npu_ss
prep -top orca_npu_ss

[files]
orca_npu_ss.v
